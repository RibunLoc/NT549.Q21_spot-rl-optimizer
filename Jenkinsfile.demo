// Demo workload pipeline — chạy trên Spot agent để tạo workload thực tế
// Mục đích: cung cấp jobs thực để controller DQN quan sát pending/running
// và ra quyết định PROVISION/HOLD/RELEASE có bằng chứng rõ ràng.
//
// Cách dùng:
//   1. Tạo Jenkins Job mới → Pipeline → chọn "Pipeline script from SCM"
//   2. Trỏ tới repo này, Jenkinsfile path: Jenkinsfile.demo
//   3. Trigger thủ công hoặc dùng script trigger_workload.sh
//
// Tham số:
//   WORKLOAD_SIZE: small (mặc định) | medium | large
//   SLEEP_SECONDS: thời gian giả lập xử lý (mặc định 120s)
pipeline {
    // agent none ở top-level — mỗi stage tự chọn agent để retry độc lập
    // khi spot bị reclaim, chỉ stage đó retry, không restart toàn bộ pipeline
    agent none

    parameters {
        choice(
            name: 'WORKLOAD_SIZE',
            choices: ['small', 'medium', 'large'],
            description: 'small=1 task, medium=3 tasks, large=6 tasks (chạy parallel)'
        )
        string(
            name: 'SLEEP_SECONDS',
            defaultValue: '120',
            description: 'Số giây mỗi task giả lập xử lý (mặc định 120s = 2 phút)'
        )
    }

    options {
        timeout(time: 60, unit: 'MINUTES') // tăng lên để chứa retry
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        BUILD_LABEL = "demo-workload-${BUILD_NUMBER}"
    }

    stages {

        // ── 1. Announce ───────────────────────────────────────────────────────
        stage('Announce') {
            agent { label 'spot-worker' }
            steps {
                echo """
=== Demo Workload Build #${BUILD_NUMBER} ===
Size      : ${params.WORKLOAD_SIZE}
Duration  : ${params.SLEEP_SECONDS}s per task
Purpose   : Generate real Jenkins queue depth for DQN controller to observe
"""
            }
        }

        // ── 2. Setup ──────────────────────────────────────────────────────────
        stage('Setup') {
            agent { label 'spot-worker' }
            steps {
                sh '''
                    echo "[setup] Node: $(hostname)"
                    echo "[setup] CPU cores: $(nproc)"
                    echo "[setup] Memory: $(free -h | grep Mem | awk '{print $2}')"
                    echo "[setup] Disk: $(df -h / | tail -1 | awk '{print $4}') free"
                    python3 --version
                '''
            }
        }

        // ── 3. Workload — retry tối đa 3 lần nếu spot bị reclaim ─────────────
        // Khi AWS terminate spot instance, Jenkins mất agent → stage FAIL.
        // retry(3) tự động requeue lên spot-worker mới do controller provision.
        stage('Workload') {
            agent { label 'spot-worker' }
            options {
                retry(3)          // thử lại tối đa 3 lần nếu agent mất
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                script {
                    def size   = params.WORKLOAD_SIZE ?: 'small'
                    def sleepS = params.SLEEP_SECONDS ?: '120'
                    def taskCounts = [small: 1, medium: 3, large: 6]
                    def nTasks = taskCounts[size] ?: 1

                    echo "[workload] attempt on ${env.NODE_NAME} — ${nTasks} task(s) × ${sleepS}s"

                    def tasks = [:]
                    for (int i = 1; i <= nTasks; i++) {
                        def taskId = i
                        tasks["task-${taskId}"] = {
                            sh """
                                echo "[task-${taskId}] START on \$(hostname) at \$(date)"
                                python3 -c "
import time, math
start = time.time()
target = int('${sleepS}')
count = 0; n = 2
while time.time() - start < target:
    if all(n % i != 0 for i in range(2, int(math.sqrt(n)) + 1)):
        count += 1
    n += 1
print(f'[task-${taskId}] {count} primes in {time.time()-start:.1f}s')
"
                                echo "[task-${taskId}] DONE at \$(date)"
                            """
                        }
                    }
                    parallel tasks
                }
            }
            post {
                failure {
                    echo "[workload] FAILED — spot instance may have been reclaimed. Jenkins will retry on next available spot-worker."
                }
                success {
                    echo "[workload] completed OK on ${env.NODE_NAME}"
                }
            }
        }

        // ── 4. Report ─────────────────────────────────────────────────────────
        stage('Report') {
            agent { label 'spot-worker' }
            steps {
                script {
                    def duration = currentBuild.durationString ?: 'unknown'
                    echo """
=== Build #${BUILD_NUMBER} completed ===
Workload    : ${params.WORKLOAD_SIZE}
Build time  : ${duration}

Controller metrics to check:
  spot_rl_pending_jobs        — spiked during queue
  spot_rl_running_jobs        — this job counted here
  spot_rl_interrupt_streak    — should increase if spot was reclaimed
  spot_rl_action_total        — PROVISION if pending was high
"""
                }
            }
        }
    }

    post {
        success {
            echo "Build #${BUILD_NUMBER} SUCCESS"
        }
        failure {
            echo "Build #${BUILD_NUMBER} FAILED after retries — manual check needed"
        }
        aborted {
            echo "Build #${BUILD_NUMBER} ABORTED"
        }
    }
}

